# ─────────────────────────────────────────────────────────────────────────────
# Fusion CDC Engine — Transform Worker (DuckDB, replaces Spark)
#
# Image: fusion/transform-worker:local
# Purpose: Run all 10 transform types via DuckDB + write to Postgres / Iceberg
#
# Bigger than cdc-worker (needs DuckDB, polars, pyarrow, pyiceberg)
# but scale-to-zero means this cost only incurs when transforms run.
# ─────────────────────────────────────────────────────────────────────────────
ARG PYTHON_VERSION=3.11

# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        default-libmysqlclient-dev \
        libpq-dev \
        libssl-dev \
        libffi-dev \
        pkg-config \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY transform-worker/requirements.txt ./requirements.txt

RUN pip install --upgrade pip \
    && pip install --prefix=/install --no-cache-dir -r requirements.txt

# ── Stage 2: production ───────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim AS runtime

LABEL org.opencontainers.image.title="fusion-transform-worker" \
      org.opencontainers.image.description="Fusion CDC Engine – Transform Worker (DuckDB)" \
      org.opencontainers.image.vendor="Fusion" \
      org.opencontainers.image.version="2.0.0"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        libssl3 \
        default-mysql-client \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 2001 -r transform \
    && useradd -r -u 2001 -g transform -d /app -s /sbin/nologin transform

COPY --from=builder /install /usr/local
COPY transform-worker/ .

# v1.2.37 Bug #26 fix (§7a): bake the DuckDB ``mysql`` extension into a
# fixed, non-``$HOME``-dependent path (``/opt/duckdb_extensions``) so the
# runtime process (which runs as the non-root ``transform`` user with
# ``HOME=/app``, while the image builds as root with ``HOME=/root``) can
# find it. A naive ``RUN python3 -c "import duckdb; ... INSTALL mysql"``
# lands in ``/root/.duckdb/extensions/...`` and the runtime looks in
# ``/app/.duckdb/extensions/...`` — reproducing the missing-extension error
# even though the file exists elsewhere in the image (GitHub #12775, #18237,
# #15471). Setting ``extension_directory`` explicitly at install AND at
# runtime (loader.py ``_open_duckdb_scanner``) avoids the ``$HOME`` trap
# entirely. ``duckdb==0.10.3`` is pinned in requirements.txt — bumping it
# would invalidate the pre-baked extension (fails loudly, per #16337).
RUN mkdir -p /opt/duckdb_extensions /tmp/duckdb \
    && python3 -c "import duckdb; c=duckdb.connect(); c.execute(\"SET extension_directory='/opt/duckdb_extensions'\"); c.execute('INSTALL mysql'); c.execute('LOAD mysql')" \
    && chown -R transform:transform /app /tmp/duckdb /opt/duckdb_extensions

USER transform

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD pgrep -f "worker.py" || exit 1

CMD ["python", "worker.py"]
